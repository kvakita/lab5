    },
    {
      "name": "Запрос 2.2 — фильтрация по типу и идентификатору",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/scoring-runs?type=branch&id=7700000009",
          "host": ["{{baseUrl}}"],
          "path": ["scoring-runs"],
          "query": [
            { "key": "type", "value": "branch" },
            { "key": "id", "value": "7700000009" }
          ]
        }
      }
    },
    {
      "name": "Запрос 3.1 — получение существующего запуска",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('runId exists', function () {",
              "  pm.expect(pm.collectionVariables.get('runId')).to.be.ok;",
              "});",
              "pm.test('Status is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/scoring-runs/{{runId}}",
          "host": ["{{baseUrl}}"],
          "path": ["scoring-runs", "{{runId}}"]
        }
      }
    },
